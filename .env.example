# ===== LOOKSMAXXING AI — integração de IA =====
# Configure UM provedor. Sem chave, o app mostra uma mensagem explicando
# que a integração precisa ser configurada (nenhuma edição é simulada).

# Provedor: "openai" ou "replicate". Se vazio, é detectado pela chave presente.
IMAGE_PROVIDER=

# --- OpenAI (Images API /v1/images/edits) ---
OPENAI_API_KEY=
# Modelo de edição de imagem (padrão: gpt-image-1)
OPENAI_IMAGE_MODEL=gpt-image-1
# Qualidade: low | medium | high (padrão: high)
OPENAI_IMAGE_QUALITY=high

# --- Replicate (FLUX.1 Kontext) ---
REPLICATE_API_TOKEN=
# Modelo no formato owner/name (padrão: black-forest-labs/flux-kontext-pro)
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

# Limite de edições por IP por minuto (padrão: 8)
RATE_LIMIT_PER_MINUTE=8
