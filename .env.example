# Copie este arquivo para .env e preencha pelo menos UMA chave.
# O .env nunca deve ser enviado para o GitHub (já está no .gitignore).

# Opção mais simples: uma chave do OpenRouter dá acesso a GPT, Claude, Grok,
# Kimi, Gemini e DeepSeek. Crie em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chaves diretas de cada provedor (opcional; têm prioridade sobre o OpenRouter)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Modelo-base do Divine AI 1.0, no formato provedor:id
# Provedores: openrouter, openai, claude, grok, kimi, gemini, deepseek
# Ex.: DIVINE_BASE_MODEL=claude:claude-sonnet-5-5
#      DIVINE_BASE_MODEL=openrouter:anthropic/claude-sonnet-4.5
# Vazio = usa automaticamente o primeiro provedor com chave.
DIVINE_BASE_MODEL=

PORT=3000
MAX_TOKENS=4096
RATE_LIMIT_PER_MIN=30
# URL pública do site (enviada ao OpenRouter para identificação)
PUBLIC_URL=
